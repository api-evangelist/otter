            "url": "https://{public-api-url}/v1/storefront/availability",
            "headers": [
              {
                "name": "X-Store-Id",
                "value": ""
              },
              {
                "name": "X-Event-Id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "`RATE LIMIT: 16 per minute`\n"
