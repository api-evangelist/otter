{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Pairing Endpoints Direct Orders Endpoints API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Direct Orders Endpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Otter Query Eater's Related History Orders",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{public-api-url}/v1/eater/order-history",
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "`Provide an external eater ID to get a list of order related to that eater.`\n"
        }
      ]
    }
  ],
  "bundled": true
}