{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Pairing Endpoints Ping Endpoints API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Ping Endpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Otter Ping the System",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{public-api-url}/v1/ping",
            "headers": [
              {
                "name": "X-Store-Id",
                "value": ""
              },
              {
                "name": "X-Echo-Error",
                "value": ""
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "`RATE LIMIT: 8 per minute`\n"
        }
      ]
    }
  ],
  "bundled": true
}