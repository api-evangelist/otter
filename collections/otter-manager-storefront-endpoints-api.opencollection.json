{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Pairing Endpoints Manager Storefront Endpoints API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Manager Storefront Endpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Otter Request Pausing Storefronts of a Store",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{public-api-url}/manager/storefront/v1/storefront/pause",
            "headers": [
              {
                "name": "X-Store-Id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "`RATE LIMIT: 8 per minute`\n"
        },
        {
          "info": {
            "name": "Otter Request Unpausing Storefronts of a Store",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{public-api-url}/manager/storefront/v1/storefront/unpause",
            "headers": [
              {
                "name": "X-Store-Id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "`RATE LIMIT: 8 per minute`\n"
        },
        {
          "info": {
            "name": "Otter Get the Process Status Details of a Pause Request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{public-api-url}/manager/storefront/v1/storefront/pause/request/:requestId/status",
            "headers": [
              {
                "name": "X-Store-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "requestId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "`RATE LIMIT: 8 per minute`\n"
        },
        {
          "info": {
            "name": "Otter Get the Process Status Details of an Unpause Request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{public-api-url}/manager/storefront/v1/storefront/unpause/request/:requestId/status",
            "headers": [
              {
                "name": "X-Store-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "requestId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "`RATE LIMIT: 8 per minute`\n"
        }
      ]
    }
  ],
  "bundled": true
}