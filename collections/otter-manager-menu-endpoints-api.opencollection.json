{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Pairing Endpoints Manager Menu Endpoints API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Manager Menu Endpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Otter Get the Menus for a Store",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{public-api-url}/v1/menus",
            "headers": [
              {
                "name": "X-Store-Id",
                "value": ""
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "`RATE LIMIT: 8 per minute`\n"
        },
        {
          "info": {
            "name": "Otter Get the Async Menu Job Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{public-api-url}/v1/menus/jobs/:jobId",
            "headers": [
              {
                "name": "X-Store-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "`RATE LIMIT: 8 per minute`\n"
        },
